{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@vcp-lib/config": [
        "../../lib/config/src/index.ts",
        "vendor/@vcp-lib/config/src/index.ts"
      ],
      "@vcp-lib/config/*": [
        "../../lib/config/src/*.ts",
        "vendor/@vcp-lib/config/src/*.ts"
      ],
      "@vcp-lib/context-core": [
        "../../lib/context-core/src/index.ts",
        "vendor/@vcp-lib/context-core/src/index.ts"
      ],
      "@vcp-lib/context-core/*": [
        "../../lib/context-core/src/*.ts",
        "vendor/@vcp-lib/context-core/src/*.ts"
      ],
      "@vcp-lib/llm-runner": [
        "../../lib/llm-runner/src/runner.ts",
        "vendor/@vcp-lib/llm-runner/src/runner.ts"
      ],
      "@vcp-lib/llm-runner/*": [
        "../../lib/llm-runner/src/*.ts",
        "vendor/@vcp-lib/llm-runner/src/*.ts"
      ],
      "@vcp-lib/logging": [
        "../../lib/logging/src/index.ts",
        "vendor/@vcp-lib/logging/src/index.ts"
      ],
      "@vcp-lib/logging/*": [
        "../../lib/logging/src/*.ts",
        "vendor/@vcp-lib/logging/src/*.ts"
      ],
      "@vcp-lib/prompt-assets": [
        "../../lib/prompt-assets/src/index.ts",
        "vendor/@vcp-lib/prompt-assets/src/index.ts"
      ],
      "@vcp-lib/prompt-assets/*": [
        "../../lib/prompt-assets/src/*.ts",
        "vendor/@vcp-lib/prompt-assets/src/*.ts"
      ],
      "@vcp-lib/runtime-adapter": [
        "../../lib/runtime-adapter/src/index.ts",
        "vendor/@vcp-lib/runtime-adapter/src/index.ts"
      ],
      "@vcp-lib/runtime-adapter/*": [
        "../../lib/runtime-adapter/src/*.ts",
        "vendor/@vcp-lib/runtime-adapter/src/*.ts"
      ]
    }
  },
  "include": [
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "mcp-server/**/*.ts",
    "agents/**/*.ts",
    "skills/**/*.ts",
    "scripts/**/*.ts",
    "__tests__/**/*.ts"
  ]
}
