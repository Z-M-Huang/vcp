# ── Host Directories ────────────────────────────────────
HOST_PROJECTS_DIR=./code
HOST_SSH_DIR=~/.ssh
HOST_CLAUDE_DATA_DIR=./vcp-claude-code-data
HOST_TMP_DIR=./vcp-tmp

# ── Claude Code ──────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional: override API endpoint (for proxies/third-party providers)
# ANTHROPIC_BASE_URL=

# ── OpenAI Codex CLI ────────────────────────────────────
OPENAI_API_KEY=
# Optional: override API endpoint
# OPENAI_BASE_URL=

# ── Google Gemini CLI ───────────────────────────────────
GEMINI_API_KEY=
# Optional: Google Cloud API key (takes precedence over GEMINI_API_KEY)
# GOOGLE_API_KEY=
# Optional: Google Cloud project ID (for Vertex AI)
# GOOGLE_CLOUD_PROJECT=
